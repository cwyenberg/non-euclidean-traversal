# This .gitignore file is configured for Unity projects.

/[L|l]ibrary/
/[T|t]emp/
/[O|o]bj/
/[B|b]uild/
/[B|b]uilds/
/[L|l]ogs/
/[U|u]ser[S|s]ettings/

# Memory dumps and crash reports
# Memory dumps can contain sensitive information and are very large
*.dmg
*.dump

# Visual Studio / Rider / VS Code generated files and folders
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# OS generated files
.DS_Store
Thumbs.db

# WebGL build traces
assets/
